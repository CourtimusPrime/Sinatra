    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "pg": "^8.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.4.1",
    "react-router-dom": "^6.22.3",
    "react-swipeable": "^7.0.2"
  },
  "devDependencies": {
    "@auth/express": "^0.7.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.x",
